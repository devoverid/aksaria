{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "baseUrl": "./src",
        "paths": {
            "@generatedDB/client": ["../../../db/generated/prisma/index"],
            "@generatedDB/*": ["../../../db/generated/prisma/*"],
            "@config/*": ["./config/*"],
            "@commands/*": ["./bot/commands/*"],
            "@events/*": ["./bot/events/*"],
            "@utils/*": ["./utils/*"],
            "@type/*": ["./types/*"],
            "@adapters/*": ["./adapters/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
