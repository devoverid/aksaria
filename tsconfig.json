{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "paths": {
            "@core/*": ["./src/core/*"],
            "@discord/*": ["./src/discord/*"],
            "@generatedDB/*": ["./db/generated/prisma/*"],
            "@telegram/*": ["./src/telegram/*"]
        },
        "types": ["bun-types", "node"],
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
